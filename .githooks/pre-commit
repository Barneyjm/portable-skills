#!/bin/bash
#
# Pre-commit hook for portable-skills
#
# This hook ensures code quality before commits:
# 1. Go formatting (gofmt)
# 2. Static analysis (go vet)
# 3. Comprehensive linting (golangci-lint)
# 4. Unit tests pass
#
# To install: ./scripts/setup-hooks.sh
# To bypass (emergency only): git commit --no-verify
#

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# Print section header
header() {
    echo -e "\n${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BOLD}$1${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"
}

# Print success message
success() {
    echo -e "${GREEN}✓${NC} $1"
}

# Print failure message with explanation
fail() {
    echo -e "\n${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}${BOLD}PRE-COMMIT HOOK FAILED${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"
    echo -e "${BOLD}What failed:${NC} $1\n"
    echo -e "${BOLD}Why this matters:${NC}"
    echo -e "$2\n"
    echo -e "${BOLD}How to fix:${NC}"
    echo -e "$3\n"
    echo -e "${YELLOW}Tip:${NC} Run './scripts/setup-hooks.sh check' to run all checks manually.\n"
    exit 1
}

# Print warning message
warn() {
    echo -e "${YELLOW}⚠${NC} $1"
}

echo -e "${BOLD}Portable Skills Pre-Commit Checks${NC}"
echo -e "Running quality checks before commit...\n"

# Get the repo root
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# Get list of staged Go files
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ -z "$STAGED_GO_FILES" ]; then
    success "No Go files staged - skipping Go checks"
    exit 0
fi

# ============================================================================
# CHECK 1: Go Formatting (gofmt)
# ============================================================================
header "Check 1/4: Go Formatting (gofmt)"

UNFORMATTED=$(gofmt -l $STAGED_GO_FILES 2>&1 || true)

if [ -n "$UNFORMATTED" ]; then
    echo -e "Files with formatting issues:"
    for file in $UNFORMATTED; do
        echo -e "  ${RED}•${NC} $file"
    done

    fail "Go formatting check failed" \
        "All Go code must be formatted with gofmt. This ensures consistent code style
across the entire codebase, making code reviews easier and reducing merge conflicts." \
        "Run the following command to fix formatting:

    gofmt -w $UNFORMATTED

Or fix all files at once:

    gofmt -w ."
fi

success "All staged Go files are properly formatted"

# ============================================================================
# CHECK 2: Static Analysis (go vet)
# ============================================================================
header "Check 2/4: Static Analysis (go vet)"

VET_OUTPUT=$(go vet ./... 2>&1) || {
    echo -e "$VET_OUTPUT"

    fail "go vet found issues" \
        "go vet catches common mistakes that the compiler doesn't catch, such as:
  • Printf format string mismatches
  • Unreachable code
  • Suspicious constructs that often indicate bugs" \
        "Review the errors above and fix each issue. Common fixes:
  • Format string issues: Ensure %v, %s, %d etc. match the argument types
  • Unreachable code: Remove or fix the logic that makes code unreachable
  • Shadowed variables: Rename variables to avoid shadowing

For more details on each issue, see: https://pkg.go.dev/cmd/vet"
}

success "go vet found no issues"

# ============================================================================
# CHECK 3: Linting (golangci-lint)
# ============================================================================
header "Check 3/4: Linting (golangci-lint)"

# Check if golangci-lint is installed
if ! command -v golangci-lint &> /dev/null; then
    warn "golangci-lint not installed - skipping detailed lint checks"
    echo -e "  Install it with: go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest"
else
    LINT_OUTPUT=$(golangci-lint run --timeout=5m 2>&1) || {
        echo -e "$LINT_OUTPUT"

        fail "golangci-lint found issues" \
            "golangci-lint runs multiple linters to catch:
  • Unchecked errors (errcheck) - All errors must be handled or explicitly ignored
  • Inefficient code patterns (ineffassign, staticcheck)
  • Security issues (gosec)
  • Code complexity issues" \
            "Fix each issue reported above. Common patterns:

  ${BOLD}Unchecked error:${NC}
    Before:  file.Close()
    After:   _ = file.Close()  // Explicitly ignore
    Or:      if err := file.Close(); err != nil { ... }

  ${BOLD}Unused variable:${NC}
    Remove the variable or use it

  ${BOLD}Shadow declaration:${NC}
    Rename the inner variable to avoid confusion

Run 'golangci-lint run --fix' to auto-fix some issues."
    }

    success "golangci-lint found no issues"
fi

# ============================================================================
# CHECK 4: Unit Tests
# ============================================================================
header "Check 4/4: Unit Tests"

# Run tests with race detector (but skip if explicitly disabled)
if [ "${SKIP_TESTS:-}" = "1" ]; then
    warn "Tests skipped (SKIP_TESTS=1)"
else
    TEST_OUTPUT=$(go test -race -short ./... 2>&1) || {
        echo -e "$TEST_OUTPUT"

        fail "Unit tests failed" \
            "All unit tests must pass before committing. This ensures:
  • Your changes don't break existing functionality
  • The codebase remains in a working state
  • Other developers can trust that main branch works" \
            "Run the failing tests individually for more details:

    go test -v -race ./path/to/package

Common fixes:
  • Test expects different output: Update test or fix the code
  • Race condition: Add proper synchronization (mutex, channel, etc.)
  • Missing test data: Ensure test fixtures exist

To run a specific test:
    go test -v -race -run TestName ./path/to/package"
    }

    success "All unit tests passed"
fi

# ============================================================================
# All checks passed!
# ============================================================================
echo -e "\n${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}${BOLD}ALL PRE-COMMIT CHECKS PASSED${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"

exit 0
